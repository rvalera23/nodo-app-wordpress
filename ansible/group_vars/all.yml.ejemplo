# --- ESTRUCTURA DE CONFIGURACIÓN DEL NODO WORDPRESS ---
# Copia este archivo como 'all.yml' y rellena los valores reales.

wp_container_name: "wordpress_app"

# Dirección IP o Hostname del Nodo de Bases de Datos
db_host_ip: "100.79.126.31" 

# Credenciales de la Base de Datos
db_user: "nodo_user"
db_name: "wordpress_db"
# ¡IMPORTANTE! Define aquí la contraseña real o mantenla cifrada en el vault
db_password: "TU_CONTRASEÑA_SEGURA_AQUI"

# Optimización de PHP
php_upload_limit: "256M"
php_post_limit: "256M"
php_memory_limit: "512M"
php_max_execution_time: "300"
php_max_input_vars: "3000"

# Debugging
wp_debug: false
