# --- Archivos generados dinámicamente por Ansible ---
docker-compose.yml
ansible/site.yml.retry

# --- Configuración real y secretos (¡NUNCA SUBIR AL REPO!) ---
.env
.env.local
.env.*
ansible/group_vars/all.yml

# --- Directorios de datos, persistencia y backups ---
/wordpress_data/
/backups/

# --- Artefactos, logs y archivos temporales ---
*.log
*.tmp
.DS_Store
__pycache__/
*.pyc

# --- Permisos de Ansible Vault (si decides usarlo) ---
.vault_pass

# --- Lo que SÍ queremos en el repo (Plantillas y Ejemplos) ---
# (Nota: Estos patrones no están ignorados, por lo que Git los rastreará)
!ansible/group_vars/all.yml.example
